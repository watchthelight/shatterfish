# The Codex is generated bytes compared byte for byte on every platform (story 2.1): line feeds
# only, whatever the checkout's autocrlf says.
codex/** text eol=lf

# The generated pages are the same bytes under the same drift check (story 2.9); a checkout that
# turned their line feeds into carriage returns would fail it on Windows and nowhere else.
docs/codex/** text eol=lf

# The pin and the scripts that read it are read by both a shell and a Java reader (story 2.8).
# A carriage return a Windows checkout left behind makes two identical hashes compare unequal
# in the shell, and turns a `#!/usr/bin/env sh` line into a shebang no kernel knows.
vanilla.pin text eol=lf
tools/*.sh text eol=lf

# The Seed sets are derived bytes compared byte for byte on every platform (story 3.1): a
# checkout that turned their line feeds into carriage returns would fail the drift check on
# Windows and nowhere else.
seeds/** text eol=lf
# The Registrations and the comparison ledger: the Rig appends to the ledger, and a checkout
# that rewrote its endings would weld a CRLF into a file whose format says line feeds only.
registrations/** text eol=lf
# The Brains' weight sets (story 4.5): each file must be its canonical text, byte for byte, because
# its text is hashed into the Brain's configuration; a carriage return would make it another file.
weights/** text eol=lf

# Shatterfish's own sources and documents are line feeds, whatever a Windows checkout would
# otherwise write (story 3.1). Six files were rewritten CRLF for four lines of content, which
# turned a six-line edit to a fairness gate into a 248-line diff -- exactly the cover a widening
# of that gate would travel under. Upstream's own modules are deliberately not named here: their
# index is line feeds already and their worktree is not.
shatterfish/** text eol=lf
docs/** text eol=lf
tools/** text eol=lf
*.md text eol=lf
mkdocs.yml text eol=lf
calibration/** text eol=lf
results/** text eol=lf
