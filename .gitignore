# Built application files
*.apk

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# Gradle build files
.gradle/
build/
release/

# Local configuration file (sdk path, etc)
local.properties

#intellij project files
*.iml
*.idea

# Shatterfish
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
_bmad/render/
_bmad/config.user.toml
_bmad/custom/config.user.toml
site/
__pycache__/
*.pyc

# Playwright MCP session files
.playwright-mcp/

# UX workspace scratch (mock drafts before promotion to mockups/)
_bmad-output/**/.working/

# IDE output under the Shatterfish modules
shatterfish/*/bin/

# The second pinned source of the Codex (story 2.8): vanilla Pixel Dungeon, read only,
# fetched by tools/fetch-vanilla.sh at the commit vanilla.pin names. Not committed, because
# it is another project's tree and the pin is what this repository owns.
vanilla-src/

# A Run says where it ran (story 3.3). It belongs in the Run's own working directory,
# never in a module's: a test that plays a Run in this process leaves one here.
where.txt

# Overlay Runs launched without --out (story 5.1, :overlay:launch)
overlay-runs/
